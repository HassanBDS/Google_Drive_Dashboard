# ============================================
# Google Drive Dashboard — Environment Config
# ============================================
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Place your Google Cloud Service Account JSON key file in the secrets/ folder
# 3. Share your target Google Drive folder with the service account email (as Viewer or Editor)
# 4. Fill in the path and folder ID below:

GDRIVE_CREDENTIALS_PATH=./secrets/service-account.json
GDRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here
GDRIVE_DRIVE_NAME="My Google Drive"
